# Copy to .env and fill in your own values. Prefixed with BANKPIPE_.

BANKPIPE_ANTHROPIC_API_KEY=
BANKPIPE_ANTHROPIC_MODEL=claude-sonnet-4-6
BANKPIPE_RULE_CONFIDENCE_THRESHOLD=0.75
BANKPIPE_DEFAULT_CURRENCY=EUR

# UK tax reporting — all optional, defaults give a no-op behaviour.
# Set GBP_RATE_SOURCE to "hmrc-monthly" to stamp Transaction.gbp_rate
# from the HMRC CSV at ingest time. HMRC_RATE_PATH defaults to
# data/fx/hmrc-monthly-average.csv. COMMODITIES_METADATA_PATH defaults
# to data/commodities.toml when that file exists. TAX_REPORTS_DIR is
# the root tax-report writes <year>/ subdirectories under.
BANKPIPE_GBP_RATE_SOURCE=null
BANKPIPE_HMRC_RATE_PATH=
BANKPIPE_COMMODITIES_METADATA_PATH=
BANKPIPE_TAX_REPORTS_DIR=reports/uk-tax
