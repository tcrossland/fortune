# Copy to .env and fill in your own values. Prefixed with BANKPIPE_.

BANKPIPE_ANTHROPIC_API_KEY=
BANKPIPE_ANTHROPIC_MODEL=claude-sonnet-4-6
BANKPIPE_RULE_CONFIDENCE_THRESHOLD=0.75
BANKPIPE_DEFAULT_CURRENCY=EUR

# UK tax reporting — all optional, defaults give a no-op behaviour.
# HMRC_RATE_PATH defaults to data/fx/hmrc-monthly-average.csv;
# COMMODITIES_METADATA_PATH defaults to data/commodities.toml when it
# exists; TAX_REPORTS_DIR is the root tax-report writes <year>/ under.
BANKPIPE_HMRC_RATE_PATH=
BANKPIPE_COMMODITIES_METADATA_PATH=
BANKPIPE_TAX_REPORTS_DIR=reports/uk-tax

# Output directory for the `reconcile` command's summary.txt / drift.csv.
BANKPIPE_RECONCILIATION_DIR=reports/reconciliation

# Structured / personal runtime config — gbp_rate_source,
# uk_residence_start_date, fig_claim_years, and the counterparty /
# beneficiary account maps — now lives in the [settings] table of
# banking-pipeline.toml (readable TOML rather than env JSON). Any
# matching BANKPIPE_* var set here still overrides the TOML.
