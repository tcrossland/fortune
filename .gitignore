# Local environment
.env

# Per-machine rebuild config — Dropbox / iCloud paths shouldn't end up
# in the repo. Copy from banking-pipeline.example.toml and edit.
banking-pipeline.toml

# Personal UK-tax commodity metadata (held ISINs, reporting status).
# Copy from data/commodities.example.toml and edit.
data/commodities.toml

# Personal pre-ledger opening positions (historical cost basis).
# Copy from data/opening-positions.example.toml and edit.
data/opening-positions.toml

# Personal excess reportable income table (fund ERI + equalisation).
# Copy from data/eri.example.toml and edit.
data/eri.toml

# Generated / personal ledger data. The pipeline writes per-year ingest
# output, the portfolio/prices/balances aggregates, the transaction
# sidecars, and the *.md summaries here — all derived from personal
# statements. The committed *.example.toml and data/fx CSV are tracked
# and unaffected by these patterns.
data/*.beancount
data/*.transactions.jsonl
data/*.md

# Hand-curated bean-check root — references the personal portfolio
# structure, so kept local rather than committed.
main.beancount

# Generated reports (personal financial output). Scoped so the
# hand-written build scripts at reports/ root stay visible.
reports/uk-tax/
reports/reconciliation/
reports/*.html
# …but keep the hand-written HTML template (source, not generated output).
!reports/*_template.html
reports/*.json

# macOS
.DS_Store

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.claude
